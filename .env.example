PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticket_demo
PUBLIC_BASE_URL=
TELEBIRR_RECEIVER=09XXXXXXXX
# Must match Telebirr receipt `credited_party_name` (case-insensitive). Example:
TELEBIRR_RECEIVER_NAME=Alazar Tilahun Taye
JWT_SECRET=change_me
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_USER_BOT_TOKEN=
# Public username of the user ticket bot (no @), for t.me/?start=ORDER_REF links from the web app
# TELEGRAM_USER_BOT_USERNAME=YourTicketBot
TELEGRAM_ADMIN_WEBHOOK_SECRET=change_me
TELEGRAM_USER_WEBHOOK_SECRET=change_me
TELEGRAM_SETUP_SECRET=change_me
ADMIN_TELEGRAM_IDS=
SCANNER_API_KEY=change_me
# After deploy, run: npm run db:migrate (applies new migrations, e.g. audit_action enum values).
# Scanner web login JWT lifetime (days). Default 3.
# SCANNER_SESSION_DAYS=3
# Optional: Telebirr verifier — POST JSON {"receipt_no":"..."} — must be one continuous URL (no space between :8001 and /api).
# RECEIPT_VERIFY_TELEBIRR_URL=http://88.99.189.198:8001/api/verify/verify-telebirr/
# RECEIPT_VERIFY_TIMEOUT_MS=15000
# RECEIPT_VERIFY_SKIP_RECEIVER_CHECK=true
# After successful check-in, DM the guest via TELEGRAM_USER_BOT_TOKEN (optional):
# TICKETR_COMMUNITY_CHANNEL_URL=https://t.me/+xxxx or https://t.me/yourchannel
#
# Optional: auto-post when an event is published. Use @YourPublicChannel or -100… id (user bot must be channel admin).
# TELEGRAM_EVENTS_CHANNEL_CHAT_ID=@YourChannel
#
# User bot privacy gate — bump version when policy text changes (users re-accept).
# PRIVACY_POLICY_VERSION=1
# Optional link shown in Telegram:
# PRIVACY_POLICY_URL=https://example.com/privacy
